---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="card-page">
		<p class="hint">Haz clic o toca la tarjeta para girarla</p>

		<div
			class="card-scene"
			id="businessCard"
			role="button"
			tabindex="0"
			aria-label="Tarjeta de visita de EVA PENADO. Pulsa para mostrar el reverso."
			aria-pressed="false"
		>
			<div class="card">
				<div class="face front">
					<img
						src="/assets/tarjeta-gris-frente.png"
						alt="Tarjeta de EVA PENADO"
					/>
				</div>

				<div class="face back">
					<img
						src="/assets/tarjeta-gris-reverso.png"
						alt="Reverso de la tarjeta de EVA PENADO"
					/>

					<a
						class="website-link"
						href="https://espacioevapenado.com/"
						target="_blank"
						rel="noopener noreferrer"
					>
						espacioevapenado.com
					</a>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	const scene = document.querySelector('#businessCard');
	const card = document.querySelector('.card');

	scene?.addEventListener('click', (event) => {
		if (
			event.target instanceof HTMLElement &&
			event.target.closest('.website-link')
		) {
			return;
		}

		card?.classList.toggle('is-flipped');
	});

	scene?.addEventListener('keydown', (event) => {
		if (event.key === 'Enter' || event.key === ' ') {
			event.preventDefault();
			card?.classList.toggle('is-flipped');
		}
	});
</script>

<style>
	.card-page {
		min-height: 100vh;
		display: grid;
		place-items: center;
		align-content: center;
		gap: 18px;
		padding: 40px 20px;
		background: radial-gradient(
			circle at 50% 35%,
			#ffffff 0%,
			#f5f4f3 52%,
			#ebe9e7 100%
		);
	}

	.hint {
		margin: 0;
		color: #777;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 12px;
		letter-spacing: 0.05em;
	}

	.card-scene {
		width: min(86vw, 560px);
		aspect-ratio: 533 / 306;
		cursor: pointer;
		perspective: 1800px;
	}

	.card {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		transition: transform 950ms cubic-bezier(0.18, 0.78, 0.18, 1);
	}

	.card.is-flipped {
		transform: rotateY(180deg);
	}

	.face {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		backface-visibility: hidden;
	}

	.face img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: fill;
		user-select: none;
		pointer-events: none;
	}

	.back {
		transform: rotateY(180deg);
	}

	```css
.website-link {
	position: absolute;
	left: 50%;
	top: 50%;
	z-index: 3;

	transform: translate(-50%, -50%);

	padding: 7px 13px;

	color: #29252a;
	background: transparent;

	border: 1px solid rgba(41, 37, 42, 0.75);
	border-radius: 999px;

	text-decoration: none;

	font-family: Georgia, 'Times New Roman', serif;
	font-size: clamp(10px, 1.8vw, 14px);
	font-style: italic;
	font-weight: 600;
	letter-spacing: 0.01em;
	white-space: nowrap;

	/* Parpadeo suave */
	animation: websiteBlink 2s ease-in-out infinite;

	transition:
		transform 0.25s ease,
		border-color 0.25s ease,
		box-shadow 0.25s ease;
}

/* Brillo al pasar el ratón */
.website-link:hover,
.website-link:focus-visible {
	transform: translate(-50%, -50%) scale(1.06);

	background: transparent;

	border-color: #29252a;

	box-shadow:
		0 0 6px rgba(41, 37, 42, 0.25),
		0 0 14px rgba(41, 37, 42, 0.15);

	outline: none;
}

/* Parpadeo */
@keyframes websiteBlink {
	0%,
	100% {
		opacity: 0.55;
		box-shadow: 0 0 0 rgba(41, 37, 42, 0);
	}

	50% {
		opacity: 1;
		box-shadow:
			0 0 5px rgba(41, 37, 42, 0.22),
			0 0 12px rgba(41, 37, 42, 0.12);
	}
}

/* En móvil y personas que prefieren menos movimiento */
@media (prefers-reduced-motion: reduce) {
	.website-link {
		animation: none;
	}
}

---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="card-page">

		<!-- ================================
		     BIENVENIDA
		     ================================= -->

		<section class="welcome" aria-label="Bienvenida">
			<h1>Bienvenido a Eva Penado</h1>
			<p>estudio de arquitectura e interiorismo</p>
		</section>


		<!-- ================================
		     TARJETA
		     ================================= -->

		<section class="card-container">

			<p class="hint">
				Haz clic o toca la tarjeta para girarla
			</p>

			<div
				class="card-scene"
				id="businessCard"
				role="button"
				tabindex="0"
				aria-label="Tarjeta de visita de EVA PENADO. Pulsa para mostrar el reverso."
				aria-pressed="false"
			>

				<div class="card">

					<!-- FRENTE -->

					<div class="face front">
						<img
							src="/assets/tarjeta-gris-frente.png"
							alt="Tarjeta de EVA PENADO"
						/>
					</div>


					<!-- REVERSO -->

					<div class="face back">

						<img
							src="/assets/tarjeta-gris-reverso.png"
							alt="Reverso de la tarjeta de EVA PENADO"
						/>

						<a
							class="website-link"
							href="https://espacioevapenado.com/"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Visitar espacioevapenado.com"
						>
							espacioevapenado.com
						</a>

					</div>

				</div>

			</div>

		</section>

	</main>
</Layout>


<script>
	const scene = document.querySelector('#businessCard');
	const card = scene?.querySelector('.card');

	if (scene && card) {

		const flipCard = () => {

			const flipped =
				card.classList.toggle('is-flipped');

			scene.setAttribute(
				'aria-pressed',
				String(flipped)
			);

			scene.setAttribute(
				'aria-label',
				flipped
					? 'Tarjeta de visita de EVA PENADO. Pulsa para mostrar el frente.'
					: 'Tarjeta de visita de EVA PENADO. Pulsa para mostrar el reverso.'
			);
		};


		/* CLIC / TOQUE */

		scene.addEventListener('click', (event) => {

			const target = event.target;

			if (
				target instanceof HTMLElement &&
				target.closest('.website-link')
			) {
				return;
			}

			flipCard();
		});


		/* TECLADO */

		scene.addEventListener('keydown', (event) => {

			if (
				event.key === 'Enter' ||
				event.key === ' '
			) {

				event.preventDefault();

				flipCard();
			}
		});
	}
</script>


<style>

	/* =========================================
	   PÁGINA
	   ========================================= */

	.card-page {

		min-height: 100vh;

		display: flex;
		flex-direction: column;

		align-items: center;
		justify-content: center;

		padding: 40px 20px;

		box-sizing: border-box;

		background:
			radial-gradient(
				circle at 50% 35%,
				#ffffff 0%,
				#f5f4f3 52%,
				#ebe9e7 100%
			);

		overflow: hidden;
	}


	/* =========================================
	   BIENVENIDA
	   ========================================= */

	.welcome {

		text-align: center;

		margin-bottom: 34px;

		animation:
			welcomeAppear
			1.8s
			cubic-bezier(0.22, 1, 0.36, 1)
			both;

	}


	.welcome h1 {

		margin: 0;

		font-family:
			'Ivi Bodoni',
			'Bodoni 72',
			'Bodoni MT',
			Didot,
			serif;

		font-size:
			clamp(
				30px,
				5vw,
				58px
			);

		font-weight: 400;

		letter-spacing: 0.015em;

		color: #29252a;

		line-height: 1.05;

	}


	.welcome p {

		margin: 12px 0 0;

		font-family:
			'Ivi Bodoni',
			'Bodoni 72',
			'Bodoni MT',
			Didot,
			serif;

		font-size:
			clamp(
				14px,
				2vw,
				20px
			);

		font-style: italic;

		font-weight: 400;

		letter-spacing: 0.035em;

		color: #777;

		animation:
			subtitleAppear
			1.6s
			0.45s
			cubic-bezier(0.22, 1, 0.36, 1)
			both;
	}


	/* =========================================
	   CONTENEDOR
	   ========================================= */

	.card-container {

		display: flex;
		flex-direction: column;

		align-items: center;

		animation:
			cardEntrance
			1.8s
			0.25s
			cubic-bezier(0.22, 1, 0.36, 1)
			both;

	}


	/* =========================================
	   TEXTO DE AYUDA
	   ========================================= */

	.hint {

		margin: 0 0 16px;

		color: #777;

		font-family:
			Arial,
			Helvetica,
			sans-serif;

		font-size: 12px;

		letter-spacing: 0.05em;

		opacity: 0;

		animation:
			hintAppear
			1.2s
			1.1s
			ease-out
			forwards;

	}


	/* =========================================
	   ESCENA 3D
	   ========================================= */

	.card-scene {

		position: relative;

		width: min(86vw, 560px);

		aspect-ratio: 533 / 306;

		cursor: pointer;

		perspective: 1800px;

		-webkit-tap-highlight-color: transparent;

		outline: none;

	}


	/* =========================================
	   SOMBRA FLOTANTE
	   ========================================= */

	.card-scene::after {

		content: '';

		position: absolute;

		left: 7%;
		right: 7%;

		bottom: -14%;

		height: 18%;

		border-radius: 50%;

		background:
			rgba(
				30,
				25,
				30,
				0.25
			);

		filter: blur(20px);

		transform:
			translateZ(-30px);

		pointer-events: none;

		transition:
			transform 500ms ease,
			opacity 500ms ease;
	}


	/* =========================================
	   EFECTO DE PROFUNDIDAD AL HOVER
	   ========================================= */

	.card-scene:hover .card {

		transform:
			rotateX(1.2deg)
			rotateY(-1.5deg)
			translateY(-4px)
			translateZ(8px);

	}


	.card-scene:hover::after {

		transform:
			translateZ(-30px)
			scale(0.94);

		opacity: 0.8;

	}


	/* =========================================
	   FOCO TECLADO
	   ========================================= */

	.card-scene:focus-visible {

		outline:
			2px solid #777;

		outline-offset: 10px;

	}


	/* =========================================
	   TARJETA
	   ========================================= */

	.card {

		position: relative;

		display: block;

		width: 100%;
		height: 100%;

		transform-style: preserve-3d;

		-webkit-transform-style: preserve-3d;

		transition:
			transform 950ms cubic-bezier(
				0.18,
				0.78,
				0.18,
				1
			);

		filter:

			drop-shadow(
				0 18px 22px
				rgba(
					35,
					30,
					35,
					0.24
				)
			)

			drop-shadow(
				0 4px 6px
				rgba(
					35,
					30,
					35,
					0.16
				)
			);

	}


	/* =========================================
	   GIRO
	   ========================================= */

	.card.is-flipped {

		transform:
			rotateY(180deg);

	}


	/* =========================================
	   CARAS
	   ========================================= */

	.face {

		position: absolute;

		inset: 0;

		width: 100%;
		height: 100%;

		backface-visibility: hidden;

		-webkit-backface-visibility: hidden;

		user-select: none;

		-webkit-user-drag: none;

	}


	/* =========================================
	   IMÁGENES
	   ========================================= */

	.face img {

		display: block;

		width: 100%;
		height: 100%;

		object-fit: fill;

		user-select: none;

		-webkit-user-drag: none;

		pointer-events: none;

	}


	/* =========================================
	   FRENTE
	   ========================================= */

	.front {

		transform:
			rotateY(0deg);

	}


	/* =========================================
	   REVERSO
	   ========================================= */

	.back {

		transform:
			rotateY(180deg);

	}


	/* =========================================
	   BOTÓN WEB
	   ========================================= */

	.website-link {

		position: absolute;

		left: 50%;
		top: 50%;

		z-index: 3;

		transform:
			translate(-50%, -50%);

		padding:
			7px 13px;

		color: #29252a;

		background: transparent;

		border:
			1px solid
			rgba(
				41,
				37,
				42,
				0.75
			);

		border-radius: 999px;

		text-decoration: none;

		font-family:
			Georgia,
			'Times New Roman',
			serif;

		font-size:
			clamp(
				10px,
				1.8vw,
				14px
			);

		font-style: italic;

		font-weight: 600;

		letter-spacing: 0.01em;

		white-space: nowrap;

		animation:
			websiteBlink
			2.4s
			ease-in-out
			infinite;

		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;

	}


	/* =========================================
	   HOVER BOTÓN
	   ========================================= */

	.website-link:hover,
	.website-link:focus-visible {

		transform:
			translate(-50%, -50%)
			scale(1.06);

		background: transparent;

		border-color:
			#29252a;

		box-shadow:

			0 0 6px
			rgba(
				41,
				37,
				42,
				0.25
			),

			0 0 14px
			rgba(
				41,
				37,
				42,
				0.15
			);

		outline: none;

	}


	/* =========================================
	   PARPADEO DEL BOTÓN
	   ========================================= */

	@keyframes websiteBlink {

		0%,
		100% {

			opacity: 0.45;

			box-shadow:
				0 0 0
				rgba(
					41,
					37,
					42,
					0
				);

		}

		50% {

			opacity: 1;

			box-shadow:

				0 0 5px
				rgba(
					41,
					37,
					42,
					0.22
				),

				0 0 12px
				rgba(
					41,
					37,
					42,
					0.12
				);

		}

	}


	/* =========================================
	   ANIMACIÓN BIENVENIDA
	   ========================================= */

	@keyframes welcomeAppear {

		from {

			opacity: 0;

			transform:
				translateY(18px);

		}

		to {

			opacity: 1;

			transform:
				translateY(0);

		}

	}


	@keyframes subtitleAppear {

		from {

			opacity: 0;

			transform:
				translateY(10px);

		}

		to {

			opacity: 1;

			transform:
				translateY(0);

		}

	}


	/* =========================================
	   ENTRADA DE TARJETA
	   ========================================= */

	@keyframes cardEntrance {

		from {

			opacity: 0;

			transform:
				translateY(35px)
				scale(0.96);

		}

		to {

			opacity: 1;

			transform:
				translateY(0)
				scale(1);

		}

	}


	@keyframes hintAppear {

		from {

			opacity: 0;

		}

		to {

			opacity: 1;

		}

	}


	/* =========================================
	   MÓVIL
	   ========================================= */

	@media (max-width: 600px) {

		.card-page {

			padding:
				30px 15px;

		}


		.welcome {

			margin-bottom: 26px;

		}


		.card-scene {

			width: 92vw;

		}


		.hint {

			font-size: 11px;

		}


		.website-link {

			padding:
				6px 10px;

		}

	}


	/* =========================================
	   MENOS MOVIMIENTO
	   ========================================= */

	@media (prefers-reduced-motion: reduce) {

		.welcome,
		.welcome p,
		.card-container,
		.hint {

			animation: none;

			opacity: 1;

		}


		.card {

			transition: none;

		}


		.website-link {

			animation: none;

			transition: none;

		}

	}

</style>
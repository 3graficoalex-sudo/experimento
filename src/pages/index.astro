---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="card-page">

	<!-- BIENVENIDA -->
	<section class="welcome">
		<h1>Bienvenido a Eva Penado</h1>
		<p>estudio de arquitectura e interiorismo</p>
	</section>

	<p class="hint">Haz clic o toca la tarjeta para girarla</p>

	<div
		class="card-scene"
		id="businessCard"
		role="button"
		tabindex="0"
		aria-label="Tarjeta de visita de EVA PENADO. Pulsa para mostrar el reverso."
		aria-pressed="false"
	>
		<div class="card">

			<div class="face front">
				<img
					src="/assets/tarjeta-gris-frente.png"
					alt="Tarjeta de EVA PENADO"
				/>
			</div>

			<div class="face back">
				<img
					src="/assets/tarjeta-gris-reverso.png"
					alt="Reverso de la tarjeta de EVA PENADO"
				/>

				<a
					class="website-link"
					href="https://espacioevapenado.com/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Visitar espacioevapenado.com"
				>
					espacioevapenado.com
				</a>
			</div>

		</div>
	</div>

	</main>
</Layout>

<script>
	const scene = document.querySelector('#businessCard');
	const card = document.querySelector('.card');

	function flipCard() {
		if (!card || !scene) return;

		card.classList.toggle('is-flipped');

		scene.setAttribute(
			'aria-pressed',
			String(card.classList.contains('is-flipped'))
		);
	}

	scene?.addEventListener('click', (event) => {
		if (
			event.target instanceof HTMLElement &&
			event.target.closest('.website-link')
		) {
			return;
		}

		flipCard();
	});

	scene?.addEventListener('keydown', (event) => {
		if (event.key === 'Enter' || event.key === ' ') {
			event.preventDefault();
			flipCard();
		}
	});
</script>

<style>
	/* =========================
	   PÁGINA
	   ========================= */

	.card-page {
		min-height: 100vh;
		display: grid;
		place-items: center;
		align-content: center;
		gap: 18px;
		padding: 40px 20px;

		background: radial-gradient(
			circle at 50% 35%,
			#ffffff 0%,
			#f5f4f3 52%,
			#ebe9e7 100%
		);

		overflow: hidden;
	}


	/* =========================
	   ANIMACIÓN DE BIENVENIDA
	   ========================= */

	.welcome {
		text-align: center;
		margin: 0 0 2px 0;

		animation: welcomeFade 1.5s ease-out both;
	}

	.welcome h1 {
		margin: 0;

		color: #29252a;

		font-family:
			'Ivi Bodoni',
			'Bodoni 72',
			'Bodoni MT',
			Didot,
			serif;

		font-size: clamp(30px, 6vw, 54px);
		font-weight: 400;

		letter-spacing: 0.015em;
		line-height: 1.05;
	}

	.welcome p {
		margin: 10px 0 0;

		color: #777;

		font-family:
			'Ivi Bodoni',
			'Bodoni 72',
			'Bodoni MT',
			Didot,
			serif;

		font-size: clamp(14px, 2.2vw, 19px);
		font-style: italic;
		letter-spacing: 0.04em;

		animation: subtitleFade 1.7s ease-out 0.25s both;
	}

	@keyframes welcomeFade {
		from {
			opacity: 0;
			transform: translateY(16px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes subtitleFade {
		from {
			opacity: 0;
			transform: translateY(8px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}


	/* =========================
	   TEXTO DE AYUDA
	   ========================= */

	.hint {
		margin: 0;

		color: #777;

		font-family:
			Arial,
			Helvetica,
			sans-serif;

		font-size: 12px;
		letter-spacing: 0.05em;

		animation: hintFade 1.5s ease-out 0.5s both;
	}

	@keyframes hintFade {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}


	/* =========================
	   ESCENA DE LA TARJETA
	   ========================= */

	.card-scene {
		position: relative;

		width: min(86vw, 560px);
		aspect-ratio: 533 / 306;

		cursor: pointer;

		perspective: 1800px;

		outline: none;
	}


	/* =========================
	   SOMBRA / CUERPO
	   ========================= */

	.card-scene::after {
		content: '';

		position: absolute;

		left: 5%;
		right: 5%;
		bottom: -12px;

		height: 22px;

		background: rgba(35, 30, 35, 0.16);

		border-radius: 50%;

		filter: blur(13px);

		z-index: -1;

		opacity: 0.65;

		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}

	.card-scene:hover::after {
		opacity: 0.8;
		transform: scale(0.96);
	}


	/* =========================
	   TARJETA 3D
	   ========================= */

	.card {
		position: relative;

		display: block;

		width: 100%;
		height: 100%;

		transform-style: preserve-3d;
		-webkit-transform-style: preserve-3d;

		transform: rotateY(0deg);

		transition:
			transform 950ms cubic-bezier(
				0.18,
				0.78,
				0.18,
				1
			);

		filter:
			drop-shadow(
				0 18px 22px
				rgba(35, 30, 35, 0.24)
			)
			drop-shadow(
				0 4px 6px
				rgba(35, 30, 35, 0.16)
			);
	}

	.card.is-flipped {
		transform: rotateY(180deg);
	}


	/* =========================
	   CARAS
	   ========================= */

	.face {
		position: absolute;

		inset: 0;

		width: 100%;
		height: 100%;

		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;

		user-select: none;
		-webkit-user-drag: none;
	}

	.face img {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: fill;

		user-select: none;
		-webkit-user-drag: none;

		pointer-events: none;
	}

	.front {
		transform: rotateY(0deg);
	}

	.back {
		transform: rotateY(180deg);
	}


	/* =========================
	   BOTÓN WEB
	   ========================= */

	.website-link {
		position: absolute;

		left: 50%;
		top: 50%;

		z-index: 10;

		transform: translate(-50%, -50%);

		padding: 6px 12px;

		color: #29252a;

		background: transparent;

		border: 1px solid rgba(41, 37, 42, 0.8);

		border-radius: 999px;

		text-decoration: none;

		font-family:
			Georgia,
			'Times New Roman',
			serif;

		font-size: clamp(10px, 1.8vw, 14px);

		font-style: italic;

		font-weight: 600;

		letter-spacing: 0.01em;

		white-space: nowrap;

		animation:
			websiteBlink
			2.2s
			ease-in-out
			infinite;

		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.website-link:hover,
	.website-link:focus-visible {
		transform:
			translate(-50%, -50%)
			scale(1.06);

		background: transparent;

		border-color: #29252a;

		box-shadow:
			0 0 5px rgba(41, 37, 42, 0.3),
			0 0 14px rgba(41, 37, 42, 0.16);

		outline: none;
	}


	/* =========================
	   PARPADEO
	   ========================= */

	@keyframes websiteBlink {
		0%,
		100% {
			opacity: 0.45;

			box-shadow:
				0 0 0 rgba(41, 37, 42, 0);
		}

		50% {
			opacity: 1;

			box-shadow:
				0 0 5px rgba(41, 37, 42, 0.25),
				0 0 13px rgba(41, 37, 42, 0.12);
		}
	}


	/* =========================
	   ACCESIBILIDAD
	   ========================= */

	.card-scene:focus-visible {
		outline: 2px solid #777;
		outline-offset: 8px;
	}


	/* =========================
	   MÓVIL
	   ========================= */

	@media (max-width: 600px) {

		.card-page {
			padding: 28px 16px;
		}

		.card-scene {
			width: 92vw;
		}

		.website-link {
			padding: 5px 10px;
		}
	}


	/* =========================
	   REDUCIR MOVIMIENTO
	   ========================= */

	@media (prefers-reduced-motion: reduce) {

		.welcome,
		.welcome p,
		.hint {
			animation: none;
		}

		.card {
			transition: none;
		}

		.website-link {
			animation: none;
		}
	}
</style>
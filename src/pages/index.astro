```astro
---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="card-page">
		<p class="hint">Haz clic o toca la tarjeta para girarla</p>

		<div
			class="card-scene"
			id="businessCard"
			role="button"
			tabindex="0"
			aria-label="Tarjeta de visita de EVA PENADO. Pulsa para mostrar el reverso."
			aria-pressed="false"
		>
			<div class="card">
				<div class="face front">
					<img
						src="/assets/tarjeta-gris-frente.png"
						alt="Tarjeta de EVA PENADO"
					/>
				</div>

				<div class="face back">
					<img
						src="/assets/tarjeta-gris-reverso.png"
						alt="Reverso de la tarjeta de EVA PENADO"
					/>

					<a
						class="website-link"
						href="https://espacioevapenado.com/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Visitar espacioevapenado.com"
					>
						espacioevapenado.com
					</a>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script>
	const scene = document.querySelector('#businessCard');
	const card = document.querySelector('.card');

	scene?.addEventListener('click', (event) => {
		if (
			event.target instanceof HTMLElement &&
			event.target.closest('.website-link')
		) {
			return;
		}

		card?.classList.toggle('is-flipped');

		scene?.setAttribute(
			'aria-pressed',
			String(card?.classList.contains('is-flipped'))
		);
	});

	scene?.addEventListener('keydown', (event) => {
		if (event.key === 'Enter' || event.key === ' ') {
			event.preventDefault();
			card?.classList.toggle('is-flipped');

			scene?.setAttribute(
				'aria-pressed',
				String(card?.classList.contains('is-flipped'))
			);
		}
	});
</script>

<style>
	.card-page {
		min-height: 100vh;
		display: grid;
		place-items: center;
		align-content: center;
		gap: 18px;
		padding: 40px 20px;
		background: radial-gradient(
			circle at 50% 35%,
			#ffffff 0%,
			#f5f4f3 52%,
			#ebe9e7 100%
		);
	}

	.hint {
		margin: 0;
		color: #777;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 12px;
		letter-spacing: 0.05em;
	}

	.card-scene {
		position: relative;
		width: min(86vw, 560px);
		aspect-ratio: 533 / 306;
		cursor: pointer;
		perspective: 1800px;
		outline: none;
	}

	.card {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		-webkit-transform-style: preserve-3d;
		transition: transform 950ms cubic-bezier(0.18, 0.78, 0.18, 1);
	}

	.card.is-flipped {
		transform: rotateY(180deg);
	}

	.face {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}

	.face img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: fill;
		user-select: none;
		-webkit-user-drag: none;
		pointer-events: none;
	}

	.front {
		transform: rotateY(0deg);
	}

	.back {
		transform: rotateY(180deg);
	}

	/*
	 * BOTÓN SOBRE "espacioevapenado.com"
	 *
	 * El enlace está colocado en el centro
	 * del reverso de la tarjeta.
	 */
	.website-link {
		position: absolute;

		/* Posición del texto de la web */
		left: 50%;
		top: 50%;

		z-index: 10;

		transform: translate(-50%, -50%);

		padding: 6px 12px;

		color: #29252a;
		background: transparent;

		border: 1px solid rgba(41, 37, 42, 0.8);
		border-radius: 999px;

		text-decoration: none;

		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(10px, 1.8vw, 14px);
		font-style: italic;
		font-weight: 600;
		letter-spacing: 0.01em;
		white-space: nowrap;

		/*
		 * Parpadeo suave.
		 * No cambia el fondo: sigue siendo transparente.
		 */
		animation: websiteBlink 2.2s ease-in-out infinite;

		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.website-link:hover,
	.website-link:focus-visible {
		transform: translate(-50%, -50%) scale(1.06);

		background: transparent;

		border-color: #29252a;

		box-shadow:
			0 0 5px rgba(41, 37, 42, 0.3),
			0 0 14px rgba(41, 37, 42, 0.16);

		outline: none;
	}

	/*
	 * PARPADEO
	 */
	@keyframes websiteBlink {
		0%,
		100% {
			opacity: 0.45;
			box-shadow:
				0 0 0 rgba(41, 37, 42, 0);
		}

		50% {
			opacity: 1;
			box-shadow:
				0 0 5px rgba(41, 37, 42, 0.25),
				0 0 13px rgba(41, 37, 42, 0.12);
		}
	}

	.card-scene:focus-visible {
		outline: 2px solid #777;
		outline-offset: 8px;
	}

	@media (max-width: 600px) {
		.card-scene {
			width: 92vw;
		}

		.website-link {
			padding: 5px 10px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}

		.website-link {
			animation: none;
		}
	}
</style>
```
